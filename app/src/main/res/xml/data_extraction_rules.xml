<?xml version="1.0" encoding="utf-8"?>
<!--
   API 31+ 백업/기기이전 규칙.
   인증 토큰·기기 식별자는 백업에서 제외
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="datastore/auth_tokens.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/device_id.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/auth_tokens.preferences_pb" />
        <exclude
            domain="file"
            path="datastore/device_id.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
